%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 10270c569ca9fa54c8d2efc9cfdc942e, type: 3}
  m_Name: GuideCatalog
  m_EditorClassIdentifier: Assembly-CSharp::Geumeum.UI.GuideCatalogSO
  _categories:
  - Name: "\uD50C\uB808\uC774 \uAC00\uC774\uB4DC"
    Sections:
    - Heading: "\uAE30\uBCF8 \uC870\uC791"
      Entries:
      - Title: "\uC774\uB3D9\uACFC \uC2DC\uC810"
        Body: "W A S D\uB85C \uC6C0\uC9C1\uC785\uB2C8\uB2E4. \uBC29\uD5A5\uC740 \uD654\uBA74
          \uAE30\uC900\uC774\uB77C W\uB294 \uC5B8\uC81C\uB098 \uCE74\uBA54\uB77C\uAC00
          \uBCF4\uB294 \uCABD\uC785\uB2C8\uB2E4.\n\uB9C8\uC6B0\uC2A4\uB85C \uC2DC\uC810\uC744
          \uB3CC\uB9AC\uACE0, \uC67C\uCABD Shift\uB97C \uB204\uB974\uACE0 \uC788\uB294
          \uB3D9\uC548 \uB2EC\uB9BD\uB2C8\uB2E4."
      - Title: "\uAE30\uBCF8 \uACF5\uACA9"
        Body: "\uB9C8\uC6B0\uC2A4 \uC67C\uCABD \uBC84\uD2BC\uC73C\uB85C \uC954 \uBB34\uAE30\uC758
          \uAE30\uBCF8 \uACF5\uACA9\uC744 \uD569\uB2C8\uB2E4.\n\uAC80\uC740 \uC815\uBA74\uC744
          \uB113\uAC8C \uBCA0\uACE0, \uD65C\uC740 \uD654\uC0B4\uC744 \uC3D8\uACE0,
          \uBC29\uC6B8\uC740 \uC55E\uCABD\uC744 \uD754\uB4E4\uC5B4 \uCE69\uB2C8\uB2E4.\n\uC2A4\uD0DC\uBBF8\uB098\uB97C
          \uC870\uAE08\uC529 \uC4F0\uBBC0\uB85C \uB9C9\uAC70\uB098 \uAD6C\uB97C \uBAAB\uC740
          \uB0A8\uACA8 \uB450\uB294 \uAC83\uC774 \uC88B\uC2B5\uB2C8\uB2E4."
      - Title: "\uAD6C\uB974\uAE30"
        Body: "C \uD0A4\uB85C \uC6C0\uC9C1\uC774\uB358 \uBC29\uD5A5\uC73C\uB85C \uAD6C\uB985\uB2C8\uB2E4.\n\uAD6C\uB974\uAE30
          \uC2DC\uC791 \uC9C1\uD6C4 \uC7A0\uAE50\uC740 \uACF5\uACA9\uC744 \uBC1B\uC9C0
          \uC54A\uC2B5\uB2C8\uB2E4. \uC2A4\uD0DC\uBBF8\uB098\uB97C \uC4F0\uBBC0\uB85C
          \uC5F0\uB2EC\uC544 \uAD6C\uB974\uBA74 \uAE08\uBC29 \uBC14\uB2E5\uB0A9\uB2C8\uB2E4."
      - Title: "\uB77D\uC628"
        Body: "\uB9C8\uC6B0\uC2A4 \uAC00\uC6B4\uB370 \uBC84\uD2BC\uC73C\uB85C \uAC00\uAE4C\uC6B4
          \uC801\uC744 \uACE0\uC815\uD569\uB2C8\uB2E4.\n\uACE0\uC815\uD55C \uB3D9\uC548\uC5D0\uB294
          \uC2DC\uC810\uC774 \uB300\uC0C1\uC744 \uB530\uB77C\uAC00\uACE0, \uC801\uC744
          \uBC14\uB77C\uBCF8 \uCC44 \uC606\uC73C\uB85C \uB3CC\uBA70 \uC2F8\uC6B8
          \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uD65C\uB85C \uC3DC \uD654\uC0B4\uB3C4
          \uACE0\uC815\uD55C \uC801\uC744 \uD5A5\uD574 \uD718\uC5B4 \uB0A0\uC544\uAC11\uB2C8\uB2E4."
      - Title: "\uC0C1\uD638\uC791\uC6A9"
        Body: "G \uD0A4\uB85C \uB5A8\uC5B4\uC9C4 \uBB3C\uAC74\uC744 \uC90D\uACE0,
          \uD30C\uD2F0\uC6D0\uACFC \uC7A5\uBE44\uB97C \uC8FC\uACE0\uBC1B\uACE0, \uAC1D\uC8FC\uC640
          \uAC70\uB798\uD569\uB2C8\uB2E4.\n\uD53C\uD574\uB97C \uC8FC\uAC70\uB098
          \uBC1B\uC740 \uC9C1\uD6C4\uC5D0\uB294 \uD45C\uC2DC\uB418\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.
          \uC2F8\uC6C0\uC774 \uC7A6\uC544\uB4E0 \uB4A4\uC5D0 \uC815\uB9AC\uD558\uC2ED\uC2DC\uC624."
    - Heading: "\uBB34\uAE30\uC640 \uC5ED\uD560"
      Entries:
      - Title: "\uCC28\uC0AC \xB7 \uAC80"
        Body: "\uC55E\uC5D0 \uC11C\uB294 \uC5ED\uD560\uC785\uB2C8\uB2E4. \uB9C8\uC6B0\uC2A4
          \uC624\uB978\uCABD \uBC84\uD2BC\uC73C\uB85C \uD328\uB9C1\uD569\uB2C8\uB2E4.\n\uC801\uC758
          \uACF5\uACA9\uC774 \uB2FF\uB294 \uC21C\uAC04\uC5D0 \uB9C9\uC544 \uB0B4\uBA74
          \uC4F4 \uC2A4\uD0DC\uBBF8\uB098\uB97C \uB3CC\uB824\uBC1B\uACE0 \uBC18\uACA9
          \uD45C\uC2DD\uC774 \uC313\uC785\uB2C8\uB2E4. \uC313\uC778 \uD45C\uC2DD\uC740
          R \uAE30\uC220\uC5D0 \uC4F0\uC785\uB2C8\uB2E4.\n\uCC3D\uADC0\uC758 \uB3CC\uC9C4\uC740
          \uBC15\uC790\uAC00 \uBD84\uBA85\uD574 \uD328\uB9C1\uC744 \uC775\uD788\uAE30
          \uC88B\uC2B5\uB2C8\uB2E4."
      - Title: "\uC2E0\uAD81 \xB7 \uD65C"
        Body: "\uAC70\uB9AC\uB97C \uB450\uACE0 \uC2F8\uC6B0\uB294 \uC5ED\uD560\uC785\uB2C8\uB2E4.
          \uB9C8\uC6B0\uC2A4 \uC624\uB978\uCABD \uBC84\uD2BC\uC744 \uB204\uB974\uACE0
          \uC788\uC73C\uBA74 \uC815\uBC00 \uC0AC\uACA9 \uC790\uC138\uAC00 \uB418\uACE0,
          \uB5BC\uB294 \uC21C\uAC04 \uD654\uC0B4\uC744 \uC3E9\uB2C8\uB2E4.\n\uC790\uC138\uB97C
          \uC7A1\uB294 \uB3D9\uC548\uC740 \uB290\uB824\uC9C0\uC9C0\uB9CC, \uAE30\uC220\uC744
          \uC900\uBE44\uD558\uB294 \uC801\uC744 \uB9DE\uD788\uBA74 \uC2DC\uC804\uC744
          \uB04A\uC5B4 \uB0C5\uB2C8\uB2E4.\nR\uB85C \uC410\uAE30\uB97C \uBC15\uACE0
          \uAC19\uC740 \uACF3\uC744 \uC3D8\uBA74 \uC410\uAE30\uAC00 \uD130\uC9D1\uB2C8\uB2E4."
      - Title: "\uBB34\uB140 \xB7 \uBC29\uC6B8"
        Body: "\uD30C\uD2F0\uB97C \uC9C0\uD0F1\uD558\uB294 \uC5ED\uD560\uC785\uB2C8\uB2E4.
          \uBC29\uC6B8\uB85C \uC801\uC744 \uCE58\uBA74 \uC2E0\uB825\uC774 \uBAA8\uC774\uACE0,
          \uB9C8\uC6B0\uC2A4 \uC624\uB978\uCABD \uBC84\uD2BC\uC73C\uB85C \uACC1\uC5D0
          \uC788\uB294 \uD30C\uD2F0\uC6D0\uC744 \uD55C\uAEBC\uBC88\uC5D0 \uCE58\uC720\uD569\uB2C8\uB2E4.\nR\uB85C
          \uACF5\uACA9\uC744 \uB3D5\uB294 \uC9C4\uC744 \uAE54\uACE0, Q\uB85C \uC313\uC544
          \uB454 \uC794\uD5A5\uC744 \uAC70\uB46C\uB4E4\uC785\uB2C8\uB2E4.\n\uCE58\uC720\uB294
          \uACC1\uC5D0 \uC788\uC5B4\uC57C \uB2FF\uC73C\uB2C8 \uC14B\uC774 \uBD99\uC5B4
          \uB2E4\uB2C8\uC2ED\uC2DC\uC624."
      - Title: "\uBB34\uAE30 \uBC14\uAFB8\uAE30"
        Body: "\uC954 \uBB34\uAE30\uAC00 \uACE7 \uC5ED\uD560\uC785\uB2C8\uB2E4. \uBC30\uB0AD\uC5D0\uC11C
          \uB2E4\uB978 \uC885\uB958\uC758 \uBB34\uAE30\uB97C \uC7A5\uCC29\uD558\uBA74
          \uADF8 \uC790\uB9AC\uC5D0\uC11C \uC5ED\uD560\uC774 \uBC14\uB00C\uACE0 \uD2B9\uC131\uC774
          \uCD08\uAE30\uD654\uB429\uB2C8\uB2E4.\n\uAC19\uC740 \uC885\uB958\uC758
          \uBB34\uAE30\uB07C\uB9AC \uBC14\uAFB8\uBA74 \uD2B9\uC131\uC740 \uADF8\uB300\uB85C
          \uB0A8\uC2B5\uB2C8\uB2E4."
    - Heading: "\uC0DD\uC874"
      Entries:
      - Title: "\uC2A4\uD0DC\uBBF8\uB098"
        Body: "\uACF5\uACA9, \uAD6C\uB974\uAE30, \uD328\uB9C1, \uC815\uBC00 \uC0AC\uACA9\uC774
          \uC2A4\uD0DC\uBBF8\uB098\uB97C \uC501\uB2C8\uB2E4. \uD589\uB3D9\uC744 \uBA48\uCD94\uBA74
          \uB2E4\uC2DC \uCC39\uB2C8\uB2E4.\n\uBC14\uB2E5\uB09C \uCC44\uB85C\uB294
          \uD53C\uD560 \uC218\uB3C4 \uB9C9\uC744 \uC218\uB3C4 \uC5C6\uC73C\uB2C8
          \uB298 \uC870\uAE08\uC740 \uB0A8\uACA8 \uB450\uC2ED\uC2DC\uC624."
      - Title: "\uC4F0\uB7EC\uC9D0\uACFC \uBD80\uD65C"
        Body: "\uC4F0\uB7EC\uC9C0\uBA74 \uC7A0\uC2DC \uB3D9\uB8CC\uB97C \uC9C0\uCF1C\uBD05\uB2C8\uB2E4.\n\uC0B4\uC544
          \uC788\uB294 \uB3D9\uB8CC\uAC00 \uACC1\uC5D0\uC11C E \uD0A4\uB97C 3\uCD08
          \uB3D9\uC548 \uB204\uB974\uACE0 \uC788\uC73C\uBA74 \uACE7\uBC14\uB85C \uC77C\uC5B4\uB098\uACE0,
          \uC544\uBB34\uB3C4 \uC624\uC9C0 \uC54A\uC73C\uBA74 30\uCD08 \uB4A4 \uC2A4\uC2A4\uB85C
          \uC77C\uC5B4\uB0A9\uB2C8\uB2E4.\n\uC77C\uC5B4\uB0A0 \uB54C\uB9C8\uB2E4
          \uACF5\uC6A9 \uB178\uC7A3\uB3C8\uC774 \uC904\uC5B4\uB4DC\uB294\uB370, \uB3D9\uB8CC\uAC00
          \uC77C\uC73C\uCF1C \uC8FC\uBA74 \uB35C \uC783\uC2B5\uB2C8\uB2E4. \uC14B\uC774
          \uBAA8\uB450 \uC4F0\uB7EC\uC9C0\uBA74 \uC6D0\uC815\uC740 \uC2E4\uD328\uD569\uB2C8\uB2E4."
  - Name: "\uC2DC\uC2A4\uD15C \uAC00\uC774\uB4DC"
    Sections:
    - Heading: "\uC6D0\uC815"
      Entries:
      - Title: "\uC6D0\uC815\uC758 \uD750\uB984"
        Body: "\uC14B\uC774 \uC800\uC2B9\uAE38 \uB4E4\uD310\uC5D0 \uB0B4\uB824 \uC7A1\uADC0\uB97C
          \uC0AC\uB0E5\uD558\uBA70 \uD798\uC744 \uAE30\uB985\uB2C8\uB2E4.\n\uC2DC\uAC04\uC774
          \uC9C0\uB0A0\uC218\uB85D \uACB0\uACC4\uAC00 \uC881\uD600\uC9C0\uACE0, \uB9C8\uC9C0\uB9C9\uC5D0\uB294
          \uC0AC\uB2F9\uC5D0 \uB4E0 \uC8FC\uC778\uACFC \uB9DE\uC12D\uB2C8\uB2E4.\n\uC6D0\uC815
          \uC911 \uB204\uAD70\uAC00\uC758 \uC5F0\uACB0\uC774 \uB04A\uAE30\uBA74 \uADF8
          \uC0AC\uB78C\uC774 \uB3CC\uC544\uC62C \uB54C\uAE4C\uC9C0 \uC6D0\uC815\uC774
          \uBA48\uCDA5\uB2C8\uB2E4."
      - Title: "\uACB0\uACC4"
        Body: "\uB4E4\uD310\uC740 \uACB0\uACC4\uB85C \uB458\uB7EC\uC2F8\uC5EC \uC788\uACE0,
          \uACB0\uACC4\uB294 \uC138 \uBC88\uC5D0 \uAC78\uCCD0 \uC881\uD600\uC9D1\uB2C8\uB2E4.\n\uACB0\uACC4
          \uBC16\uC5D0 \uC788\uC73C\uBA74 \uACC4\uC18D \uD53C\uD574\uB97C \uC785\uACE0
          \uD68C\uBCF5\uB3C4 \uB9C9\uD799\uB2C8\uB2E4. \uCD95\uC18C\uAC00 \uC2DC\uC791\uB418\uBA74
          \uB2A6\uC9C0 \uC54A\uAC8C \uC548\uC73C\uB85C \uB4E4\uC5B4\uC624\uC2ED\uC2DC\uC624."
      - Title: "\uC9C0\uB3C4"
        Body: "Tab \uD0A4\uB85C \uD070 \uC9C0\uB3C4\uB97C \uD3BC\uCE69\uB2C8\uB2E4.
          \uD30C\uD2F0\uC6D0\uC758 \uC704\uCE58\uC640 \uACB0\uACC4\uB97C \uBCFC \uC218
          \uC788\uC2B5\uB2C8\uB2E4.\n\uC635\uC158\uC758 \uAC8C\uC784\uD50C\uB808\uC774\uC5D0\uC11C
          \uB204\uB974\uACE0 \uC788\uB294 \uB3D9\uC548\uB9CC \uD3BC\uCE58\uB3C4\uB85D
          \uBC14\uAFC0 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    - Heading: "\uC131\uC7A5"
      Entries:
      - Title: "\uB808\uBCA8\uACFC \uD2B9\uC131"
        Body: "\uC7A1\uADC0\uB97C \uC4F0\uB7EC\uB728\uB9AC\uBA74 \uACBD\uD5D8\uCE58\uAC00
          \uC313\uC785\uB2C8\uB2E4. \uB808\uBCA8\uC774 \uC624\uB97C \uB54C\uB9C8\uB2E4
          \uCD5C\uB300 \uCCB4\uB825\uC774 \uB298\uACE0 \uD2B9\uC131 \uD3EC\uC778\uD2B8\uB97C
          \uD558\uB098 \uC5BB\uC2B5\uB2C8\uB2E4.\nESC \uBA54\uB274\uC758 \uD2B9\uC131\uC5D0\uC11C
          \uBB34\uAE30\uB9C8\uB2E4 \uB2E4\uB978 \uBCC4\uC790\uB9AC\uC5D0 \uD3EC\uC778\uD2B8\uB97C
          \uC501\uB2C8\uB2E4. \uB418\uB3CC\uB9AC\uB294 \uB370 \uBE44\uC6A9\uC740
          \uB4E4\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
      - Title: "\uC7A5\uBE44"
        Body: "\uC7A1\uADC0\uAC00 \uB5A8\uC5B4\uB728\uB9B0 \uBB34\uAE30\uB294 \uB4F1\uAE09\uACFC
          \uACF5\uACA9\uB825\uC774 \uC800\uB9C8\uB2E4 \uB2E4\uB974\uACE0, \uBB34\uAE30\uC5D0
          \uB530\uB77C \uBD99\uB294 \uD2B9\uC218 \uC635\uC158\uB3C4 \uC788\uC2B5\uB2C8\uB2E4.\nESC
          \uBA54\uB274\uC758 \uBC30\uB0AD\uC5D0\uB294 \uC7A5\uBE44\uC640 \uBB3C\uC57D,
          \uAD8C\uC744 \uD569\uCCD0 12\uCE78\uAE4C\uC9C0 \uB2F4\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
      - Title: "\uC7A5\uBE44 \uAC74\uB124\uAE30"
        Body: "\uD30C\uD2F0\uC6D0 \uACC1\uC5D0\uC11C G \uD0A4\uB85C \uAC00\uC9C4
          \uC7A5\uBE44\uB97C \uAC74\uB12C \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uBC1B\uB294
          \uCABD\uC774 \uC218\uB77D\uD574\uC57C \uB118\uC5B4\uAC11\uB2C8\uB2E4.\n\uB0B4\uAC8C
          \uB9DE\uC9C0 \uC54A\uB294 \uBB34\uAE30\uB77C\uB3C4 \uADF8 \uBB34\uAE30\uB97C
          \uC4F0\uB294 \uB3D9\uB8CC\uC5D0\uAC8C\uB294 \uD070 \uD798\uC774 \uB429\uB2C8\uB2E4."
    - Heading: "\uC7AC\uD654\uC640 \uAC70\uB798"
      Entries:
      - Title: "\uB178\uC7A3\uB3C8"
        Body: "\uC7A1\uADC0\uB97C \uC4F0\uB7EC\uB728\uB9AC\uBA74 \uB178\uC7A3\uB3C8\uC774
          \uBAA8\uC785\uB2C8\uB2E4. \uC14B\uC774 \uD568\uAED8 \uC4F0\uB294 \uACF5\uC6A9
          \uC7AC\uD654\uC785\uB2C8\uB2E4.\n\uBD80\uD65C\uD560 \uB54C\uB9C8\uB2E4
          \uC77C\uBD80\uB97C \uC783\uACE0, \uC6D0\uC815\uC744 \uB9C8\uCE60 \uB54C
          \uB0A8\uC740 \uB178\uC7A3\uB3C8\uC740 \uC810\uC218\uC5D0 \uB354\uD574\uC9D1\uB2C8\uB2E4."
      - Title: "\uAC1D\uC8FC"
        Body: "\uB450 \uBC88\uC9F8 \uACB0\uACC4 \uC548\uCABD\uC758 \uC548\uC804\uD55C
          \uACF3\uC5D0 \uD55C\uB3D9\uC548 \uAC1D\uC8FC\uAC00 \uC790\uB9AC\uB97C \uD3C5\uB2C8\uB2E4.\n\uD68C\uBCF5
          \uBB3C\uC57D, \uC2E0\uB825 \uBB3C\uC57D, \uC7A5\uBE44 \uC218\uCE58\uB97C
          \uB2E4\uC2DC \uAD74\uB9AC\uB294 \uC7AC\uC870\uC815\uAD8C, \uB4F1\uAE09\uC744
          \uC62C\uB9AC\uB294 \uC0C1\uC2B9\uAD8C\uC744 \uC0B4 \uC218 \uC788\uC2B5\uB2C8\uB2E4.
          \uBB3C\uC57D\uC740 \uC885\uB958\uB9C8\uB2E4 \uB4E4\uACE0 \uB2E4\uB2D0 \uC218
          \uC788\uB294 \uC218\uAC00 \uC815\uD574\uC838 \uC788\uC2B5\uB2C8\uB2E4."
  - Name: "\uC694\uAD34 \uB3C4\uAC10"
    Sections:
    - Heading: "\uC7A1\uADC0"
      Entries:
      - Title: "\uD5C8\uAE68\uBE44"
        Body: "\uAC00\uC7A5 \uD754\uD55C \uC7A1\uADC0\uC785\uB2C8\uB2E4. \uC5EC\uB7FF\uC774
          \uBB34\uB9AC \uC9C0\uC5B4 \uB2E4\uB2C8\uBA70 \uAC00\uAE4C\uC774 \uBD99\uC5B4
          \uACF5\uACA9\uD569\uB2C8\uB2E4.\n\uACF5\uACA9 \uC804\uC758 \uD2C8\uC774
          \uAE38\uC5B4 \uB9C9\uAC70\uB098 \uD53C\uD558\uAE30 \uC27D\uC9C0\uB9CC,
          \uB458\uB7EC\uC2F8\uC774\uC9C0 \uC54A\uAC8C \uC870\uC2EC\uD558\uC2ED\uC2DC\uC624."
      - Title: "\uCC3D\uADC0"
        Body: "\uD55C \uBC29\uD5A5\uC73C\uB85C \uD06C\uAC8C \uB3CC\uC9C4\uD558\uB294
          \uC7A1\uADC0\uC785\uB2C8\uB2E4. \uB3CC\uC9C4\uD55C \uB4A4\uC5D0\uB294 \uD55C\uB3D9\uC548
          \uAD73\uC2B5\uB2C8\uB2E4.\n\uB3CC\uC9C4 \uBC15\uC790\uAC00 \uBD84\uBA85\uD574
          \uD328\uB9C1\uD558\uAE30 \uC88B\uACE0, \uC2E0\uAD81\uC740 \uB3CC\uC9C4\uC744
          \uC900\uBE44\uD558\uB294 \uC21C\uAC04\uC744 \uC815\uBC00 \uC0AC\uACA9\uC73C\uB85C
          \uB04A\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
      - Title: "\uC561\uADC0"
        Body: "\uBB34\uB9AC \uB4A4\uC5D0 \uC228\uC5B4 \uC800\uC8FC\uAC00 \uAE43\uB4E0
          \uD22C\uC0AC\uCCB4\uB97C \uB0A0\uB9BD\uB2C8\uB2E4.\n\uBAB8\uC774 \uC57D\uD558\uB2C8
          \uC55E\uC758 \uC7A1\uADC0\uC5D0\uAC8C \uBD99\uC7A1\uD788\uAE30 \uC804\uC5D0
          \uBA3C\uC800 \uC4F0\uB7EC\uB728\uB9AC\uC2ED\uC2DC\uC624."
    - Heading: "\uC0AC\uB2F9\uC758 \uC8FC\uC778"
      Entries:
      - Title: "\uAD6C\uBBF8\uD638"
        Body: "\uC800\uC2B9\uAE38 \uAE38\uBAA9\uC744 \uCC28\uC9C0\uD55C \uAD6C\uBBF8\uD638\uC785\uB2C8\uB2E4.
          \uBA85\uBD80\uC5D0 \uC624\uB974\uC9C0 \uBABB\uD55C \uC6D0\uD63C\uB4E4\uC744
          \uC0BC\uD0A4\uACE0 \uADF8 \uC5BC\uAD74\uC744 \uBE4C\uB824 \uC501\uB2C8\uB2E4.\n\uD328\uB9C1\uACFC
          \uC815\uBC00 \uC0AC\uACA9\uC73C\uB85C \uD750\uD2B8\uB7EC\uB728\uB824 \uADF8\uB85C\uAE30\uC5D0
          \uBE60\uB728\uB9B4 \uC218 \uC788\uACE0, \uBB34\uB140\uC758 \uACF5\uBA85\uC740
          \uADF8 \uD2C8\uC744 \uB113\uD600 \uC90D\uB2C8\uB2E4. \uC14B\uC758 \uD569\uC774
          \uB9DE\uC744\uC218\uB85D \uBE68\uB9AC \uBB34\uB108\uC9D1\uB2C8\uB2E4."
