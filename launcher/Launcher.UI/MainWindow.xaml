<Window x:Class="Geumeum.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="그믐 런처" Width="1280" Height="760" MinWidth="1000" MinHeight="740"
        Icon="Assets/logo.png" WindowStartupLocation="CenterScreen" WindowStyle="None"
        Background="{StaticResource Bg}" FontFamily="Malgun Gothic" Foreground="{StaticResource Text}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SubText}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="InfoValue" TargetType="TextBlock" BasedOn="{StaticResource InfoLabel}">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="16,0,0,0" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#DB111517" />
            <Setter Property="BorderBrush" Value="#363B3C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="24,18" />
        </Style>
        <Style x:Key="WindowButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        </Style>
    </Window.Resources>
    <Grid ClipToBounds="True" Background="{StaticResource Bg}">
        <Grid VerticalAlignment="Top" Height="460">
            <Image Source="Assets/banner.png" Stretch="UniformToFill" />
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#000C0E0F" Offset="0.35" />
                        <GradientStop Color="#FF0C0E0F" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,8,0">
            <Button Content="&#xE921;" Style="{StaticResource WindowButton}" ToolTip="최소화" AutomationProperties.Name="최소화" Click="OnMinimize" />
            <Button Content="&#xE922;" Style="{StaticResource WindowButton}" ToolTip="최대화 / 복원" AutomationProperties.Name="최대화 또는 복원" Click="OnMaximize" />
            <Button Content="&#xE8BB;" Style="{StaticResource WindowButton}" ToolTip="닫기" AutomationProperties.Name="닫기" Click="OnClose" />
        </StackPanel>
        <Grid Margin="28,48,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="220" />
                <RowDefinition Height="280" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Margin="24,0,0,12">
                    <Image Source="Assets/wordmark.png" Width="290" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="그믐" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0">
                    <TextBlock Text="{Binding LauncherVersionText}" Foreground="{StaticResource SubText}" FontSize="13" VerticalAlignment="Center" />
                    <Border Width="1" Height="18" Background="{StaticResource Line}" Margin="20,0" />
                    <Button Style="{StaticResource GhostButton}" Click="OnDiscord" Padding="18,9" Margin="0,0,8,0"
                            Content="공식 Discord" ToolTip="공식 Discord 서버 초대 링크를 브라우저로 엽니다"
                            AutomationProperties.Name="공식 Discord 서버 초대 링크 열기" />
                    <Button Style="{StaticResource GhostButton}" Command="{Binding AccountCommand}" Padding="18,9" Margin="0,0,8,0"
                            Visibility="{Binding HasAccount, Converter={StaticResource BoolToVis}}" Content="{Binding Account.Summary}" MaxWidth="260" />
                    <Button Style="{StaticResource GhostButton}" Command="{Binding SettingsCommand}" Padding="18,9">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="17" Margin="0,0,9,0" VerticalAlignment="Center" />
                            <TextBlock Text="설정" FontSize="14" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Text="게임 설치 정보" FontSize="19" FontWeight="SemiBold" />
                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Grid.Row="1">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="34" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                <TextBlock Text="설치된 버전" Style="{StaticResource InfoLabel}" />
                                <TextBlock Text="{Binding CurrentVersionText}" ToolTip="{Binding CurrentVersionText}" Style="{StaticResource InfoValue}" Grid.Column="1" Grid.ColumnSpan="2" />
                                <TextBlock Text="최신 버전" Style="{StaticResource InfoLabel}" Grid.Row="1" />
                                <TextBlock Text="{Binding TargetVersionText}" ToolTip="{Binding TargetVersionText}" Style="{StaticResource InfoValue}" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" />
                                <TextBlock Text="설치 경로" Style="{StaticResource InfoLabel}" Grid.Row="2" />
                                <TextBlock Text="{Binding InstallRoot}" ToolTip="{Binding InstallRoot}" Style="{StaticResource InfoValue}" Grid.Row="2" Grid.Column="1" />
                                <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource GhostButton}" Command="{Binding SettingsCommand}" Padding="6" ToolTip="설치 경로 설정" AutomationProperties.Name="설치 경로 설정" ><Path Data="M 1,4 L 7,4 9,6 19,6 19,17 1,17 Z" Stroke="{StaticResource Text}" StrokeThickness="1.5" Width="20" Height="20" Stretch="Uniform" /></Button>
                                <TextBlock Text="게임 용량" Style="{StaticResource InfoLabel}" Grid.Row="3" />
                                <TextBlock Text="{Binding GameSizeText}" Style="{StaticResource InfoValue}" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" />
                                <TextBlock Text="사용 가능한 용량" Style="{StaticResource InfoLabel}" Grid.Row="4" />
                                <TextBlock Text="{Binding AvailableSpaceText}" Style="{StaticResource InfoValue}" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Text="패치 노트" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ChannelText}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,0,0" FontSize="12" Foreground="{StaticResource SubText}" />
                        <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <TextBlock Text="{Binding PatchNotes}" TextWrapping="Wrap" FontSize="14" LineHeight="25" Foreground="#C6C8C6" Margin="0,0,12,0" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
            <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="28" /><ColumnDefinition Width="250" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding SteamLoginText}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource SubText}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SteamLoginRequired}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Warn}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding StatusText}" FontSize="18" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding DetailText}" Foreground="{StaticResource SubText}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" />
                        <TextBlock Text="{Binding WarningText}" Foreground="{StaticResource Warn}" FontSize="12" TextWrapping="Wrap">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Margin" Value="0,6,0,0" /><Style.Triggers><DataTrigger Binding="{Binding WarningText}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                        <ProgressBar Height="5" Margin="0,10,0,6" Minimum="0" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}" Visibility="{Binding ProgressVisible, Converter={StaticResource BoolToVis}}" Foreground="{StaticResource Accent}" Background="{StaticResource Line}" BorderThickness="0" />
                        <DockPanel Visibility="{Binding ProgressVisible, Converter={StaticResource BoolToVis}}">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SpeedText}" Foreground="{StaticResource SubText}" FontSize="12" />
                            <TextBlock Text="{Binding BytesText}" Foreground="{StaticResource SubText}" FontSize="12" />
                        </DockPanel>
                    </StackPanel>
                    <Button Grid.Column="2" Height="58" VerticalAlignment="Center" Style="{StaticResource PrimaryButton}" Content="{Binding PrimaryButtonText}" Command="{Binding PrimaryCommand}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>



