<Window x:Class="Geumeum.Launcher.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="설정" Width="620" Height="530" Icon="Assets/logo.png"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" FontFamily="Malgun Gothic" ShowInTaskbar="False">
    <Grid>
        <Grid.Clip>
            <RectangleGeometry Rect="0,0,620,530" RadiusX="12" RadiusY="12" />
        </Grid.Clip>
        <Border CornerRadius="12">
            <Border.Background>
                <ImageBrush ImageSource="Assets/settings-background.png" Stretch="UniformToFill" />
            </Border.Background>
        </Border>
        <Border Height="56" VerticalAlignment="Top" Background="Transparent"
                Panel.ZIndex="1" MouseLeftButtonDown="OnDragWindow" />
        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,16,0"
                Width="30" Height="28" Padding="7" Panel.ZIndex="1"
                Style="{StaticResource GhostButton}" BorderBrush="Transparent"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                ToolTip="설정 닫기" AutomationProperties.Name="설정 닫기" Click="OnClose">
            <Path Data="M 0,0 L 12,12 M 12,0 L 0,12" Stroke="{StaticResource Text}" StrokeThickness="1.5" />
        </Button>
        <Border Background="#99101416" BorderBrush="#343A3C" BorderThickness="1" CornerRadius="12">
    <Grid Margin="32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="런처 설정" Foreground="{StaticResource Text}" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,18" />
            <TextBlock Text="업데이트 서버" Style="{StaticResource Label}" Margin="0,0,0,4" />
            <TextBlock x:Name="ServerHint" Foreground="{StaticResource SubText}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
            <TextBlock Text="설치 위치" Style="{StaticResource Label}" Margin="0,14,0,4" />
        </StackPanel>
        <DockPanel Grid.Row="1">
            <Button DockPanel.Dock="Right" Content="찾아보기" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnBrowse" />
            <TextBox x:Name="RootBox" Background="{StaticResource Panel}" Foreground="{StaticResource Text}"
                     BorderBrush="{StaticResource Line}" Padding="6,5" FontSize="13" />
        </DockPanel>
        <TextBlock Grid.Row="2" Text="바꾸면 새 위치에 다시 설치한다. 기존 폴더는 옮기거나 지우지 않는다."
                   Foreground="{StaticResource SubText}" FontSize="11" Margin="0,4,0,0" />

        <TextBlock Grid.Row="3" Text="채널" Style="{StaticResource Label}" />
        <ComboBox Grid.Row="4" x:Name="ChannelBox" Width="220" HorizontalAlignment="Left" FontSize="13">
            <ComboBoxItem Tag="internal" Content="internal (팀 테스트)" />
            <ComboBoxItem Tag="stable" Content="stable" />
        </ComboBox>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,22,0,0" VerticalAlignment="Top">
            <Button Content="파일 검사·복구" Style="{StaticResource GhostButton}" Click="OnRepair" />
            <Button Content="로그 폴더 열기" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="OnOpenLogs" />
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="취소" Style="{StaticResource GhostButton}" IsCancel="True" Width="90" />
            <Button Content="저장" Style="{StaticResource PrimaryButton}" FontSize="14" Width="90" Height="34"
                    Margin="10,0,0,0" IsDefault="True" Click="OnSave" />
        </StackPanel>
    </Grid>
        </Border>
    </Grid>
</Window>

