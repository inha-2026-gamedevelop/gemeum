<Window x:Class="Geumeum.Launcher.RoomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="그믐 · 원정대" Width="1200" Height="900" MinWidth="960" MinHeight="680" WindowStartupLocation="CenterOwner"
        Background="#0C0F10" Foreground="#E8E7E3" FontFamily="Malgun Gothic" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="RaidButton" TargetType="Button">
            <Setter Property="Background" Value="#1B1F20"/><Setter Property="Foreground" Value="#E8E7E3"/>
            <Setter Property="BorderBrush" Value="#4C5050"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,10"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border CornerRadius="3" x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#E0B96C"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#F4D99E"/><Setter TargetName="Frame" Property="BorderThickness" Value="2"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.7"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.35"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="Foreground" Value="#E8E7E3"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border CornerRadius="5" x:Name="Row" Background="#D91B1F20" BorderBrush="#414646" BorderThickness="1" Padding="24,20"><ContentPresenter/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#292C2B"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#33322B"/><Setter TargetName="Row" Property="BorderBrush" Value="#E0B96C"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#F4D99E"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid IsHitTestVisible="False" Opacity="0.55">
            <Grid.Background><RadialGradientBrush Center="0.2,0.75" RadiusX="0.9" RadiusY="0.8"><GradientStop Color="#303634"/><GradientStop Color="#080B0C" Offset="1"/></RadialGradientBrush></Grid.Background>
            <Viewbox VerticalAlignment="Bottom" Stretch="Fill" Height="280" Opacity="0.65">
                <Canvas Width="1200" Height="280">
                    <Path Fill="#333A36" Data="M0,220 L90,147 120,161 189,69 209,87 233,80 290,153 348,125 423,194 492,155 541,178 613,103 634,117 672,96 721,171 790,143 859,199 940,141 990,182 1080,111 1200,203 1200,280 0,280Z"/>
                    <Path Fill="#171E1B" Data="M0,207 L55,174 106,207 171,123 202,168 239,158 320,229 413,188 503,231 610,180 674,226 730,184 816,230 920,183 981,220 1100,165 1200,231 1200,280 0,280Z"/>
                    <Path Fill="#080D0C" Data="M0,252 L70,230 149,246 242,218 316,251 432,234 540,257 663,228 789,256 870,236 950,258 1080,231 1200,250 1200,280 0,280Z"/>
                </Canvas>
            </Viewbox>
        </Grid>
    <Grid Margin="26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border BorderBrush="#736044" BorderThickness="0,0,0,1" Padding="0,0,0,16" Margin="0,0,0,20">
            <Grid><StackPanel><TextBlock Text="그믐  /  원정대" Foreground="#E0B96C" FontSize="11" Margin="0,0,0,5"/><TextBlock Text="파티 찾기" FontFamily="Batang" FontSize="36" FontWeight="Bold"/></StackPanel>
                <TextBlock Text="3인 협동 원정" Foreground="#B1B1AA" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="PartyColumn" Width="0"/></Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel><TextBlock Text="모집 중인 파티" FontFamily="Batang" FontSize="21" Foreground="#E0B96C"/><TextBlock x:Name="RoomCount" Text="0개 파티" HorizontalAlignment="Right" Foreground="#B1B1AA"/></DockPanel>
                <ListBox Grid.Row="1" x:Name="Rooms" SelectionChanged="OnSelectionChanged" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate><DataTemplate><Grid>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontFamily="Batang" FontSize="23" TextTrimming="CharacterEllipsis"/>
                            <WrapPanel Margin="0,10,0,0">
                                <TextBlock Text="{Binding OwnerNickname, StringFormat=♛  {0}}" Foreground="#D1CEC4" Margin="0,0,15,0"/>
                                <TextBlock Text="{Binding Occupancy}" Foreground="#D1CEC4" Margin="0,0,15,0"/>
                                <Border Background="#302D24" CornerRadius="12" Padding="10,2"><TextBlock Text="{Binding StateLabel}" Foreground="#E0B96C" FontSize="11"/></Border>
                            </WrapPanel>
                        </StackPanel>

                    </Grid></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="1" x:Name="EmptyRooms" Text="모집 중인 파티가 없습니다.&#10;&#10;새로운 원정대를 만들어 보세요." TextAlignment="Center" VerticalAlignment="Center" Foreground="#B1B1AA" IsHitTestVisible="False" Visibility="Collapsed"/>
                <TextBlock Grid.Row="2" x:Name="BrowseInfo" TextWrapping="Wrap" Foreground="#E0B96C" Margin="0,14,0,0"/>
            </Grid>
            <Border x:Name="PartyPanel" Visibility="Collapsed" CornerRadius="5" Grid.Column="1" Margin="24,0,0,0" Background="#DC131718" BorderBrush="#474944" BorderThickness="1" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel><TextBlock x:Name="PartyHeading" Text="선택한 파티 정보" Foreground="#E0B96C" FontSize="12"/><TextBlock x:Name="SelectedTitle" Text="원정대를 선택하세요" FontFamily="Batang" FontSize="28" Margin="0,8,0,6" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="OwnerInfo" Foreground="#B1B1AA" TextTrimming="CharacterEllipsis"/></StackPanel>
                    <Border Grid.Row="1" BorderBrush="#474944" BorderThickness="0,1,0,0" Margin="0,12,0,8" Padding="0,8,0,0"><TextBlock Text="파티원" Foreground="#E0B96C"/></Border>
                    <ItemsControl Grid.Row="2" x:Name="Members"><ItemsControl.ItemTemplate><DataTemplate>
                        <Border CornerRadius="3" Background="#C9222626" BorderBrush="#474944" BorderThickness="1" Padding="12,7" Margin="0,0,0,6"><Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="66"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Position}" Foreground="#E0B96C" FontSize="18" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Role}" Foreground="#B1B1AA" FontSize="11" Margin="0,4,0,0"/></StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#B1B1AA"/><Style.Triggers><DataTrigger Binding="{Binding Connected}" Value="True"><Setter Property="Foreground" Value="#85CFBD"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                        </Grid></Border>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <StackPanel Grid.Row="3" x:Name="Preparation">
                        <TextBlock Text="내 선호 무기" Foreground="#E0B96C" Margin="0,8,0,6"/>
                        <StackPanel x:Name="WeaponButtons" Orientation="Horizontal">
                            <Button Content="검 · 차사" Tag="0" Click="OnPreference" Style="{StaticResource RaidButton}" Padding="12,10" Margin="0,0,6,0"/>
                            <Button Content="활 · 신궁" Tag="1" Click="OnPreference" Style="{StaticResource RaidButton}" Padding="12,10" Margin="0,0,6,0"/>
                            <Button Content="방울 · 무녀" Tag="2" Click="OnPreference" Style="{StaticResource RaidButton}" Padding="12,10"/>
                        </StackPanel>
                        <TextBlock x:Name="PartyNotice" FontSize="12" Foreground="#B1B1AA" TextWrapping="Wrap" Margin="0,8,0,8"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Button x:Name="BotButton" Content="빈자리 봇 추가" Click="OnBots" Style="{StaticResource RaidButton}" Margin="0,0,6,0"/>
                            <Button Grid.Column="1" x:Name="ReadyButton" Content="준비 완료" Click="OnReady" Style="{StaticResource RaidButton}"/>
                        </Grid>
                        <Button x:Name="StartButton" Content="원정 출발" Click="OnStart" Style="{StaticResource RaidButton}" Background="#DCB565" Foreground="#15130F" BorderBrush="#E6C98C" FontWeight="Bold" Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid></ScrollViewer>
            </Border>
        </Grid>
        <StackPanel Grid.Row="2" Margin="0,16">
            <StackPanel x:Name="RoomCreationOptions">
            <TextBlock Text="새 원정대 이름 (2~16자)" Foreground="#E0B96C" Margin="0,0,0,6"/>
            <TextBox x:Name="RoomName" MaxLength="16" Padding="10,8" Text="그믐 원정대" Background="#DC131718" Foreground="#E8E7E3" BorderBrush="#4C5050" CaretBrush="#E0B96C"/>
            </StackPanel>
            <TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="#B1B1AA" FontSize="11" Margin="0,10,0,0"/>
        </StackPanel>
        <WrapPanel x:Name="Actions" Grid.Row="3" HorizontalAlignment="Right">
            <Button Content="목록 새로고침" Click="OnRefresh" Style="{StaticResource RaidButton}" Margin="0,0,8,0"/>
            <Button x:Name="CloseRoomButton" Content="파티 해산" IsEnabled="False" Click="OnCloseRoom" Style="{StaticResource RaidButton}" Margin="0,0,8,0"/>
            <Button x:Name="CreateRoomButton" Content="새 파티 만들기" Click="OnCreate" Style="{StaticResource RaidButton}" Margin="0,0,8,0"/>
            <Button x:Name="JoinButton" Content="파티 참가" MinWidth="150" IsEnabled="False" Click="OnJoin" Style="{StaticResource RaidButton}"/>
        </WrapPanel>
    </Grid>
    </Grid>
</Window>
