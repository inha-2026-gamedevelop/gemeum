<Window x:Class="Geumeum.Launcher.AccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="그믐 계정" Width="500" Height="680" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}" FontFamily="Malgun Gothic" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Background" Value="#1E2426" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="CaretBrush" Value="{StaticResource Text}" />
            <Setter Property="BorderBrush" Value="#697176" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Background" Value="#1E2426" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="CaretBrush" Value="{StaticResource Text}" />
            <Setter Property="BorderBrush" Value="#697176" />
            <Setter Property="MaxLength" Value="256" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Padding" Value="0,12,0,6" />
        </Style>
    </Window.Resources>
    <Grid Margin="30,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="그믐 계정" FontSize="25" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Summary}" FontSize="13" Foreground="{StaticResource SubText}" Margin="0,8,0,18" />
            <Border Height="1" Background="{StaticResource Line}" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,12">
            <StackPanel>
                <StackPanel Visibility="{Binding IsSignedOut, Converter={StaticResource BoolToVis}}">
                    <StackPanel IsEnabled="{Binding CanEdit}">
                        <Label Content="아이디" Target="{Binding ElementName=LoginBox}" />
                        <TextBox x:Name="LoginBox" Style="{StaticResource Input}" MaxLength="24"
                                 Text="{Binding LoginId, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="아이디" />
                        <Label Content="비밀번호" Target="{Binding ElementName=LoginPassword}" />
                        <PasswordBox x:Name="LoginPassword" AutomationProperties.Name="비밀번호" />
                        <CheckBox Content="이 PC에서 자동 로그인" IsChecked="{Binding RememberLogin}"
                                  Foreground="{StaticResource Text}" Margin="0,18,0,20" />
                        <Button Content="로그인" Height="46" Style="{StaticResource PrimaryButton}" Click="OnLogin" IsDefault="True" />
                    </StackPanel>
                    <!-- 계정은 Discord에서 발급한다. 계정 서버가 닫혀 있어도 초대는 열려야 하므로 로그인 폼 바깥에 둔다 -->
                    <Border Background="{StaticResource Panel}" CornerRadius="6" Padding="14" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="계정이 없으신가요?" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                            <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="20" Foreground="{StaticResource SubText}" Margin="0,8,0,0"
                                       Text="1. 공식 Discord 서버에 참여합니다.&#x0a;2. 서버에서 /계정 명령을 실행합니다.&#x0a;3. 본인에게만 보이는 계정 설정 링크를 엽니다.&#x0a;4. 아이디, 비밀번호, 닉네임을 설정합니다.&#x0a;5. 런처로 돌아와 로그인합니다." />
                            <TextBlock Text="계정 설정 링크는 5분, 1회용입니다. 비밀번호는 Discord 채팅이 아니라 링크로 열리는 페이지에만 입력하세요."
                                       TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource SubText}" Margin="0,10,0,0" />
                            <Button Content="공식 Discord 열기" Style="{StaticResource GhostButton}" Click="OnDiscord" Margin="0,14,0,0"
                                    AutomationProperties.Name="공식 Discord 서버 초대 링크 열기" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}" IsEnabled="{Binding CanEdit}">
                    <Label Content="닉네임 (2~16자)" Target="{Binding ElementName=NicknameBox}" />
                    <TextBox x:Name="NicknameBox" Style="{StaticResource Input}" MaxLength="32"
                             Text="{Binding Nickname, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="닉네임" />
                    <Button Content="닉네임 변경" Style="{StaticResource GhostButton}" Click="OnNickname" Margin="0,10,0,18" />
                    <Expander Header="비밀번호 변경" Foreground="{StaticResource Text}">
                        <StackPanel Margin="0,4,0,12">
                            <Label Content="현재 비밀번호" Target="{Binding ElementName=CurrentPassword}" />
                            <PasswordBox x:Name="CurrentPassword" AutomationProperties.Name="현재 비밀번호" />
                            <Label Content="새 비밀번호 (8~15자)" Target="{Binding ElementName=NewPassword}" />
                            <PasswordBox x:Name="NewPassword" AutomationProperties.Name="새 비밀번호" />
                            <Label Content="새 비밀번호 확인" Target="{Binding ElementName=ConfirmPassword}" />
                            <PasswordBox x:Name="ConfirmPassword" AutomationProperties.Name="새 비밀번호 확인" />
                            <TextBlock Text="변경하면 모든 기기에서 로그아웃됩니다." Foreground="{StaticResource SubText}" Margin="0,10,0,10" FontSize="12" />
                            <Button Content="비밀번호 변경" Style="{StaticResource GhostButton}" Click="OnPassword" />
                        </StackPanel>
                    </Expander>
                    <Button Content="로그아웃" Style="{StaticResource GhostButton}" Click="OnLogout" Margin="0,18,0,0" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="6" Padding="14">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="13"
                       AutomationProperties.LiveSetting="Polite">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource SubText}" />
                        <Style.Triggers><DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Warn}" />
                        </DataTrigger></Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>
    </Grid>
</Window>
