# Copy to .env; never commit real credentials. setup-local.ps1 generates these.
GEUMEUM_ENVIRONMENT=local
GEUMEUM_DATABASE_URL=postgresql+psycopg://geumeum:CHANGE_ME@127.0.0.1:55432/geumeum
GEUMEUM_TEST_DATABASE_URL=postgresql+psycopg://geumeum:CHANGE_ME@127.0.0.1:55432/geumeum_test
GEUMEUM_HOST=127.0.0.1
GEUMEUM_PORT=8766
# Fill these from Developer Portal. Never put real tokens in this example file.
GEUMEUM_DISCORD_APPLICATION_ID=
GEUMEUM_DISCORD_PUBLIC_KEY=
GEUMEUM_DISCORD_BOT_TOKEN=
GEUMEUM_DISCORD_GUILD_ID=
# 0 disables that release channel. Internal releases should use a separate staff channel.
GEUMEUM_DISCORD_NOTICE_CHANNEL_ID=0
GEUMEUM_DISCORD_INTERNAL_CHANNEL_ID=0

# Listen hosting runs gameplay on the party owner PC. No game worker required.
GEUMEUM_GAME_HOSTING=listen
GEUMEUM_GAME_BUILD_ID=
GEUMEUM_GAME_PORT_START=18000
