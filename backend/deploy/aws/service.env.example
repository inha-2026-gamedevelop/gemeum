GEUMEUM_ENVIRONMENT=production
GEUMEUM_PUBLIC_ORIGIN=https://api.example.com
GEUMEUM_HOST=127.0.0.1
GEUMEUM_PORT=8766
GEUMEUM_DATABASE_URL=postgresql+psycopg://geumeum:REPLACE_URL_ENCODED_PASSWORD@127.0.0.1:5432/geumeum
GEUMEUM_GAME_HOSTING=listen
GEUMEUM_GAME_BUILD_ID=REPLACE_WITH_RELEASE_ID
GEUMEUM_GAME_PORT_START=18000
GEUMEUM_GAME_MAX_ROOMS=100
GEUMEUM_RELAY_ENABLED=true
GEUMEUM_RELAY_PUBLIC_ADDRESS=REPLACE_WITH_EC2_PUBLIC_IPV4
GEUMEUM_RELAY_BIND_ADDRESS=0.0.0.0
GEUMEUM_RELAY_PORT=18001
GEUMEUM_RELAY_BYTES_PER_SECOND=8000000
